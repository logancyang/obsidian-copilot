{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "dev/gallery/main.ts",
        "scripts/printPromptDebug.js",
        "scripts/printPromptDebugEntry.ts"
      ],
      "project": ["dev/gallery/**/*.{ts,tsx}", "scripts/**/*.{ts,js,mjs}"]
    },
    "apps/obsidian": {
      "entry": [
        "src/main.ts",
        "src/**/*.stories.{ts,tsx}",
        "src/lib/plugins/colorOpacityPlugin.ts"
      ],
      "project": ["src/**/*.{ts,tsx,js,jsx}"],
      "ignore": ["src/styles/tailwind.css"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
